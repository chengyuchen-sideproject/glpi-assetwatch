{#
 # Asset Watch - GLPI plugin
 # Network topology page: drawing, connections per network device, devices without connection,
 # and the form to type connections by hand (edit mode).
 # @license GPL-3.0-or-later
 #}

<style>
   .aw-topo .aw-svg-scroll { overflow: auto; max-height: 75vh; border: 1px solid var(--tblr-border-color, #ddd); border-radius: 4px; }
   .aw-topo svg { display: block; font-family: inherit; }
   .aw-topo .aw-e { fill: none; stroke: #206bc4; stroke-width: 1.6; }
   .aw-topo .aw-e-secondary { stroke-width: 1.2; opacity: .75; }
   .aw-topo .aw-e-switch { stroke: #ae3ec9; stroke-width: 2.2; }
   .aw-topo .aw-e-manual { stroke-dasharray: 5 4; }
   .aw-topo .aw-box { stroke: var(--tblr-border-color-dark, #888); stroke-width: 1; fill: var(--tblr-bg-surface, #fff); }
   .aw-topo .aw-box-sw { fill: rgba(32, 107, 196, .14); stroke: #206bc4; stroke-width: 1.5; }
   .aw-topo .aw-ext { stroke-dasharray: 4 3; }
   .aw-topo .aw-none-col { fill: none; stroke: var(--tblr-border-color-dark, #999); stroke-dasharray: 4 3; }
   .aw-topo .aw-st-ok { fill: rgba(47, 179, 68, .16); }
   .aw-topo .aw-st-offline { fill: rgba(214, 57, 57, .22); }
   .aw-topo .aw-st-retired { fill: rgba(60, 60, 60, .2); }
   .aw-topo .aw-st-disk_low { fill: rgba(247, 103, 7, .2); }
   .aw-topo .aw-t1 { font-size: 12px; font-weight: 600; fill: currentColor; }
   .aw-topo .aw-t2 { font-size: 10.5px; fill: currentColor; opacity: .75; }
   .aw-topo svg a:hover .aw-box { stroke: #206bc4; stroke-width: 2.5; }
   .aw-topo .aw-legend-line { display: inline-block; width: 28px; vertical-align: middle; border-top: 2px solid #206bc4; margin: 0 .3rem 0 .8rem; }
   .aw-topo .aw-legend-line.manual { border-top-style: dashed; }
   .aw-topo .aw-legend-line.switch { border-top-color: #ae3ec9; }
   .aw-topo .aw-edit td { vertical-align: top; }
   .aw-topo .aw-edit .aw-add { min-width: 34rem; }
   .aw-topo .aw-savebar { position: sticky; bottom: 0; background: var(--tblr-bg-surface, #fff); border-top: 1px solid var(--tblr-border-color, #ddd); padding: .6rem 0; z-index: 2; }
   @media print {
      header, aside, .navbar, .aw-noprint, footer { display: none !important; }
      .aw-topo .aw-svg-scroll { overflow: visible; max-height: none; border: none; }
      .aw-topo .card { break-inside: avoid; }
      .aw-topo svg * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
   }
</style>

{% set sources = {'auto': __('GLPI ports', 'assetwatch'), 'manual': __('Typed by hand', 'assetwatch')} %}
{% macro src_badges(list, sources) %}
   {% for s in list %}<span class="badge {{ s == 'auto' ? 'bg-blue-lt' : 'bg-secondary-lt' }} me-1">{{ sources[s] }}</span>{% endfor %}
{% endmacro %}

<div class="container-fluid aw-topo">
   <div class="d-flex flex-wrap align-items-center gap-2 my-3">
      <h2 class="m-0 me-3"><i class="ti ti-topology-star-3 me-2"></i>{{ title }}</h2>
      {{ include('@assetwatch/_scope_select.html.twig', {extra: edit ? {edit: 1} : {}}) }}
      {% if data is not null %}
         <div class="ms-auto d-flex flex-wrap gap-2 aw-noprint">
            {% if edit %}
               <a class="btn btn-outline-secondary" href="{{ self_url }}?scope={{ scope_key|url_encode }}"><i class="ti ti-eye me-1"></i>{{ __('Back to the drawing', 'assetwatch') }}</a>
            {% elseif can_edit %}
               <a class="btn btn-primary" href="{{ self_url }}?scope={{ scope_key|url_encode }}&amp;edit=1"><i class="ti ti-pencil me-1"></i>{{ __('Edit connections', 'assetwatch') }}</a>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ self_url }}?scope={{ scope_key|url_encode }}&amp;export=csv"><i class="ti ti-file-spreadsheet me-1"></i>{{ __('Export CSV', 'assetwatch') }}</a>
            {% if not edit %}<button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="ti ti-printer me-1"></i>{{ __('Print', 'assetwatch') }}</button>{% endif %}
         </div>
      {% endif %}
   </div>

   {% if datacenters is empty %}
      <div class="alert alert-info">
         {{ __('No server room yet. Create datacenters and server rooms in Assets > Datacenters, assign the racks to a room and set a location on the room.', 'assetwatch') }}
         <a href="{{ datacenter_url }}">{{ datacenter_label }}</a>
      </div>
   {% elseif data is null %}
      <div class="alert alert-info">
         {{ __('Pick a server room to see which device is plugged into which network device. Connections come from the ports connected in GLPI (SNMP network inventory) and from the ones typed by hand with "Edit connections" (port optional).', 'assetwatch') }}
      </div>
   {% else %}
      {% set nodes = data.nodes %}
      <h3 class="mb-2">{{ scope.label }} <small class="text-muted">{{ 'now'|date('Y-m-d H:i') }}</small></h3>
      <div class="d-flex flex-wrap gap-2 mb-3">
         <span class="badge bg-blue-lt fs-5 p-2">{{ __('Network devices', 'assetwatch') }}: {{ data.counts.switches }}</span>
         <span class="badge bg-success-lt fs-5 p-2">{{ __('Connected devices', 'assetwatch') }}: {{ data.counts.connected }}</span>
         <span class="badge {{ data.counts.unconnected > 0 ? 'bg-orange-lt' : 'bg-secondary-lt' }} fs-5 p-2">{{ __('No connection recorded', 'assetwatch') }}: {{ data.counts.unconnected }}</span>
         {% if data.counts.conflicts > 0 %}<span class="badge bg-danger-lt fs-5 p-2">{{ __('Port used twice', 'assetwatch') }}: {{ data.counts.conflicts }}</span>{% endif %}
      </div>

      {% if data.graph.port_conflicts is not empty %}
         <div class="alert alert-danger">
            <b>{{ __('Port used twice', 'assetwatch') }}</b> — {{ __('several assets are recorded on the same port of a network device; one of the entries is probably out of date.', 'assetwatch') }}
            <ul class="mb-0">
               {% for c in data.graph.port_conflicts %}
                  <li>{{ nodes[c.switch].name }} {{ c.port }}: {{ c.keys|map(k => nodes[k].name)|sort|join(', ') }}</li>
               {% endfor %}
            </ul>
         </div>
      {% endif %}

      {% if edit %}
         {# ---------------- Edit mode ---------------- #}
         <div class="alert alert-info">
            {{ __('For each asset, choose the network device it is plugged into (port optional) and save. Connections recorded by GLPI ports cannot be removed here; tick "Remove" to delete one typed by hand. Each change is written to the history of the asset.', 'assetwatch') }}
         </div>
         <form method="post" action="{{ self_url }}" class="aw-edit">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="scope" value="{{ scope_key }}">
            <label class="form-check mb-2">
               <input class="form-check-input" type="checkbox" id="aw-only-unconnected">
               <span class="form-check-label">{{ __('Only the assets without connection', 'assetwatch') }}</span>
            </label>
            <template id="aw-switch-options">
               <option value="0">—</option>
               {% for c in switch_choices %}<option value="{{ c.id }}">{{ c.label }}</option>{% endfor %}
            </template>
            <div class="card">
               <div class="table-responsive">
                  <table class="table table-sm table-striped card-table">
                     <thead><tr>
                        <th>{{ __('Asset', 'assetwatch') }}</th>
                        <th>{{ __('Location', 'assetwatch') }}</th>
                        <th>{{ __('Current connections', 'assetwatch') }}</th>
                        <th>{{ __('Add a connection', 'assetwatch') }}</th>
                     </tr></thead>
                     <tbody>
                     {% for key in data.ordered %}
                        {% set n = nodes[key] %}
                        <tr data-unconnected="{{ data.node_links[key] is defined ? 0 : 1 }}">
                           <td><a href="{{ n.url }}">{{ n.name }}</a><div class="small text-muted">{{ n.type_label }}</div></td>
                           <td class="text-nowrap">{{ n.where }}</td>
                           <td>
                              {% for l in data.node_links[key]|default([]) %}
                                 <div class="mb-1">
                                    {% if l.my_port %}<code>{{ l.my_port }}</code> → {% endif %}<a href="{{ nodes[l.peer].url }}">{{ nodes[l.peer].name }}</a>{% if l.peer_port %} <code>{{ l.peer_port }}</code>{% endif %}
                                    {{ _self.src_badges(l.sources, sources) }}
                                    {% for id in l.manual_ids %}
                                       <label class="form-check form-check-inline m-0 ms-1"><input class="form-check-input" type="checkbox" name="remove[]" value="{{ id }}"><span class="form-check-label small">{{ __('Remove', 'assetwatch') }}</span></label>
                                    {% endfor %}
                                 </div>
                              {% else %}
                                 <span class="text-muted">—</span>
                              {% endfor %}
                           </td>
                           <td class="aw-add">
                              <div class="d-flex gap-1">
                                 <select class="form-select form-select-sm aw-switch-select" name="add[{{ key }}][switch]" aria-label="{{ __('Network device', 'assetwatch') }}"><option value="0">—</option></select>
                                 <input class="form-control form-control-sm" style="max-width: 9rem" name="add[{{ key }}][switch_port]" placeholder="{{ __('Switch port', 'assetwatch') }}" aria-label="{{ __('Switch port', 'assetwatch') }}">
                                 <input class="form-control form-control-sm" style="max-width: 8rem" name="add[{{ key }}][device_port]" placeholder="{{ __('Device port', 'assetwatch') }}" aria-label="{{ __('Device port', 'assetwatch') }}">
                              </div>
                           </td>
                        </tr>
                     {% endfor %}
                     </tbody>
                  </table>
               </div>
            </div>
            <div class="aw-savebar">
               <button type="submit" name="save" value="1" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
            </div>
         </form>
         <script>
            (function () {
               var tpl = document.getElementById('aw-switch-options');
               // Options filled on first use: a long list is not repeated in every row of the page.
               var fill = function (e) {
                  var s = e.target;
                  if (s.classList && s.classList.contains('aw-switch-select') && !s.dataset.filled) {
                     s.dataset.filled = '1';
                     s.innerHTML = tpl.innerHTML;
                  }
               };
               document.addEventListener('focusin', fill);
               document.addEventListener('mousedown', fill);
               document.getElementById('aw-only-unconnected').addEventListener('change', function () {
                  var only = this.checked;
                  document.querySelectorAll('.aw-edit tbody tr').forEach(function (tr) {
                     tr.style.display = only && tr.dataset.unconnected !== '1' ? 'none' : '';
                  });
               });
            })();
         </script>
      {% else %}
         {# ---------------- Drawing ---------------- #}
         {% set L = data.layout %}
         {% if L.columns is empty %}
            <div class="alert alert-warning">{{ __('No computer or network device in this selection.', 'assetwatch') }}</div>
         {% else %}
            <div class="card mb-3">
               <div class="card-header">
                  <h3 class="card-title"><i class="ti ti-topology-star-3 me-1"></i>{{ __('Drawing', 'assetwatch') }}</h3>
                  <div class="ms-auto small text-muted">
                     <span class="aw-legend-line"></span>{{ __('GLPI ports', 'assetwatch') }}
                     <span class="aw-legend-line manual"></span>{{ __('Typed by hand', 'assetwatch') }}
                     <span class="aw-legend-line switch"></span>{{ __('Between network devices', 'assetwatch') }}
                  </div>
               </div>
               <div class="card-body p-2">
                  <div class="aw-svg-scroll">
                     <svg width="{{ L.width }}" height="{{ L.height }}" viewBox="0 0 {{ L.width }} {{ L.height }}" role="img" aria-label="{{ title }}">
                        {% for e in L.edges %}<path d="{{ e.d }}" class="aw-e aw-e-{{ e.kind }}{{ e.manual ? ' aw-e-manual' : '' }}"/>{% endfor %}
                        {% for col in L.columns|filter(c => c.key == none_key) %}
                           <rect class="aw-none-col" x="{{ col.x }}" y="{{ L.top }}" width="210" height="46" rx="6"/>
                           <text class="aw-t1" x="{{ col.x + 10 }}" y="{{ L.top + 19 }}">{{ __('No connection recorded', 'assetwatch') }}</text>
                           <text class="aw-t2" x="{{ col.x + 10 }}" y="{{ L.top + 36 }}">{{ __('%d device(s)', 'assetwatch')|format(data.layout.device_boxes|filter(b => b.column == none_key)|length) }}</text>
                        {% endfor %}
                        {% for key, b in L.switch_boxes %}
                           {% set n = nodes[key] %}
                           <a href="{{ n.url }}">
                              <title>{{ n.name }} — {{ n.where ?: n.type_label }}{{ n.external ? ' (' ~ __('outside the selection', 'assetwatch') ~ ')' : '' }}</title>
                              <rect class="aw-box aw-box-sw{{ n.external ? ' aw-ext' : '' }}" x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="6"/>
                              <text class="aw-t1" x="{{ b.x + 10 }}" y="{{ b.y + 19 }}">{{ b.line1 }}</text>
                              <text class="aw-t2" x="{{ b.x + 10 }}" y="{{ b.y + 36 }}">{{ b.line2 }}</text>
                           </a>
                        {% endfor %}
                        {% for b in L.device_boxes %}
                           {% set n = nodes[b.key] %}
                           <a href="{{ n.url }}">
                              <title>{{ n.name }} ({{ n.type_label }}) — {{ n.where }}{{ b.port ? ' · ' ~ b.port : '' }}{{ n.status ? ' · ' ~ status_labels[n.status].label : '' }}</title>
                              <rect class="aw-box aw-st-{{ n.status ?: 'none' }}{{ n.external ? ' aw-ext' : '' }}" x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ b.h }}" rx="4"/>
                              <text class="aw-t1" x="{{ b.x + 8 }}" y="{{ b.y + 15 }}">{{ b.line1 }}</text>
                              <text class="aw-t2" x="{{ b.x + 8 }}" y="{{ b.y + 29 }}">{{ b.line2 }}</text>
                           </a>
                        {% endfor %}
                     </svg>
                  </div>
                  <p class="small text-muted mt-2 mb-0">{{ __('Box colour = Asset Watch status (green healthy, red offline, orange low disk, grey probably removed, white no agent). Dashed box = outside the selection. A device on several network devices sits under the first one, with a line to the others.', 'assetwatch') }}</p>
               </div>
            </div>
         {% endif %}

         {# Tables: devices of each network device #}
         {% for key in data.graph.switches %}
            {% set n = nodes[key] %}
            {% set list = data.on_switch[key]|default([]) %}
            {% set peers = data.node_links[key]|default([])|filter(l => nodes[l.peer].is_switch) %}
            <div class="card mb-3">
               <div class="card-header">
                  <h3 class="card-title">
                     <i class="ti ti-network me-1"></i><a href="{{ n.url }}">{{ n.name }}</a>
                     <small class="text-muted ms-2">{{ n.where }}{{ n.external ? ' (' ~ __('outside the selection', 'assetwatch') ~ ')' : '' }}</small>
                     <span class="badge bg-secondary-lt ms-1">{{ list|length }}</span>
                  </h3>
               </div>
               {% if peers is not empty %}
                  <div class="card-body py-2 small">
                     {{ __('Between network devices', 'assetwatch') }}:
                     {% for l in peers %}{% if l.my_port %}<code>{{ l.my_port }}</code> → {% endif %}<a href="{{ nodes[l.peer].url }}">{{ nodes[l.peer].name }}</a>{% if l.peer_port %} <code>{{ l.peer_port }}</code>{% endif %}{{ not loop.last ? ' · ' : '' }}{% endfor %}
                  </div>
               {% endif %}
               {% if list is not empty %}
                  <div class="table-responsive">
                     <table class="table table-sm table-striped card-table">
                        <thead><tr>
                           <th>{{ __('Switch port', 'assetwatch') }}</th><th>{{ __('Device', 'assetwatch') }}</th><th>{{ __('Location', 'assetwatch') }}</th>
                           <th>{{ __('Device port', 'assetwatch') }}</th><th>{{ __('Status') }}</th><th>{{ __('Source', 'assetwatch') }}</th>
                        </tr></thead>
                        <tbody>
                        {% for l in list %}
                           {% set d = nodes[l.device] %}
                           <tr>
                              <td class="text-nowrap"><code>{{ l.switch_port ?: '—' }}</code></td>
                              <td><a href="{{ d.url }}">{{ d.name }}</a> <small class="text-muted">{{ d.type_label }}</small></td>
                              <td class="text-nowrap">{{ d.where }}</td>
                              <td class="text-nowrap">{{ l.device_port ?: '—' }}</td>
                              <td>{% if d.status %}<span class="badge bg-{{ status_labels[d.status].color }}{{ status_labels[d.status].color in ['success', 'danger', 'warning', 'secondary'] ? '-lt' : '' }}">{{ status_labels[d.status].label }}</span>{% endif %}</td>
                              <td>{{ _self.src_badges(l.sources, sources) }}</td>
                           </tr>
                        {% endfor %}
                        </tbody>
                     </table>
                  </div>
               {% endif %}
            </div>
         {% endfor %}

         {% if data.graph.unconnected is not empty %}
            <div class="card mb-3">
               <div class="card-header">
                  <h3 class="card-title"><i class="ti ti-plug-x me-1"></i>{{ __('No connection recorded', 'assetwatch') }} <span class="badge bg-orange-lt ms-1">{{ data.graph.unconnected|length }}</span></h3>
                  {% if can_edit %}<a class="btn btn-sm btn-outline-primary ms-auto aw-noprint" href="{{ self_url }}?scope={{ scope_key|url_encode }}&amp;edit=1">{{ __('Edit connections', 'assetwatch') }}</a>{% endif %}
               </div>
               <div class="table-responsive">
                  <table class="table table-sm table-striped card-table">
                     <thead><tr><th>{{ __('Device', 'assetwatch') }}</th><th>{{ __('Location', 'assetwatch') }}</th></tr></thead>
                     <tbody>
                     {% for key in data.graph.unconnected %}
                        <tr><td><a href="{{ nodes[key].url }}">{{ nodes[key].name }}</a> <small class="text-muted">{{ nodes[key].type_label }}</small></td><td>{{ nodes[key].where }}</td></tr>
                     {% endfor %}
                     </tbody>
                  </table>
               </div>
            </div>
         {% endif %}
      {% endif %}
   {% endif %}
</div>
