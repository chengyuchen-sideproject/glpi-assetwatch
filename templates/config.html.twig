{#
 # Asset Watch - GLPI plugin
 # Configuration page.
 # @license GPL-3.0-or-later
 #}

<div class="container-fluid" style="max-width: 60rem">
   <h2 class="my-3"><i class="ti ti-heartbeat me-2"></i>{{ __('Asset Watch', 'assetwatch') }} <small class="text-muted">v{{ version }}</small></h2>

   <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">{{ __('Health check', 'assetwatch') }}</h3></div>
      <div class="card-body">
         <p>{{ __('Monitored computers (inventoried by GLPI Agent): %d', 'assetwatch')|format(monitored) }}</p>
         {% if checks is empty %}
            <div class="alert alert-success mb-0">{{ __('Everything needed to send alerts is in place.', 'assetwatch') }}</div>
         {% else %}
            {% for check in checks %}
               <div class="alert alert-{{ check.level }}">{{ check.message }}</div>
            {% endfor %}
         {% endif %}
      </div>
   </div>

   <form method="post" action="{{ form_url }}">
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Checks', 'assetwatch') }}</h3></div>
         <div class="card-body">
            {% set flags = {
               'check_noreport': [settings.checkNoReport, __('No inventory received for too long', 'assetwatch')],
               'check_disk': [settings.checkDisk, __('Low disk space', 'assetwatch')],
               'check_hardware': [settings.checkHardware, __('Hardware change (memory, processors, hard drives)', 'assetwatch')],
               'check_identity': [settings.checkIdentity, __('Identity change (serial number, name, MAC, IP)', 'assetwatch')],
               'check_rack': [settings.checkRack, __('Rack placement change', 'assetwatch')]
            } %}
            {% for name, flag in flags %}
               <label class="form-check">
                  <input class="form-check-input" type="checkbox" name="{{ name }}" value="1" {{ flag[0] ? 'checked' : '' }}>
                  <span class="form-check-label">{{ flag[1] }}</span>
               </label>
            {% endfor %}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Missing inventory', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <div class="mb-3">
               <label class="form-label" for="noreport_default_hours">{{ __('Default threshold (hours)', 'assetwatch') }}</label>
               <input class="form-control" style="max-width: 10rem" type="number" min="1" id="noreport_default_hours" name="noreport_default_hours" value="{{ settings.noReportDefaultHours }}">
            </div>
            {% if types is not empty %}
               <label class="form-label">{{ __('Threshold per computer type (hours, empty = default)', 'assetwatch') }}</label>
               <table class="table table-sm" style="max-width: 30rem">
                  {% for type in types %}
                     <tr>
                        <td>{{ type.name }}</td>
                        <td><input class="form-control form-control-sm" type="number" min="1" name="type_hours[{{ type.id }}]" value="{{ type.hours }}"></td>
                     </tr>
                  {% endfor %}
               </table>
            {% endif %}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Disk space', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <p class="text-muted">{{ __('A partition is reported when BOTH thresholds are crossed.', 'assetwatch') }}</p>
            <div class="row mb-3">
               <div class="col-sm-6">
                  <label class="form-label" for="disk_min_free_percent">{{ __('Free space below (%)', 'assetwatch') }}</label>
                  <input class="form-control" type="number" step="0.1" min="0" max="100" id="disk_min_free_percent" name="disk_min_free_percent" value="{{ settings.diskMinFreePercent }}">
               </div>
               <div class="col-sm-6">
                  <label class="form-label" for="disk_min_free_gb">{{ __('and free space below (GB)', 'assetwatch') }}</label>
                  <input class="form-control" type="number" step="0.1" min="0" id="disk_min_free_gb" name="disk_min_free_gb" value="{{ settings.diskMinFreeGb }}">
               </div>
            </div>
            <div class="mb-3">
               <label class="form-label" for="disk_excluded_fs">{{ __('Ignored file systems (comma separated)', 'assetwatch') }}</label>
               <input class="form-control" type="text" id="disk_excluded_fs" name="disk_excluded_fs" value="{{ settings.diskExcludedFs|join(',') }}">
            </div>
            <div class="mb-3">
               <label class="form-label" for="disk_excluded_mounts">{{ __('Ignored mount points (comma separated, * wildcard)', 'assetwatch') }}</label>
               <input class="form-control" type="text" id="disk_excluded_mounts" name="disk_excluded_mounts" value="{{ settings.diskExcludedMounts|join(',') }}" placeholder="/boot*,/snap/*">
            </div>
         </div>
      </div>

      <div class="card mb-3" id="probe">
         <div class="card-header"><h3 class="card-title">{{ __('Liveness probe (between inventories)', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <p class="text-muted">
               {{ __('Every 5 minutes, ask each GLPI Agent whether it is there (the "status" request of the agent page in GLPI); when it does not answer, or for an asset in a rack without agent (switch, PDU...), try a TCP connection to the ports below. A machine that stops answering is reported within minutes instead of after the missing-inventory threshold.', 'assetwatch') }}
            </p>
            <p class="text-muted">
               {{ __('Needs: agents running as a service (default of the installers), and the GLPI host allowed to reach the machines on TCP 62354 (and the ports below). Test first with the button: nothing is saved and no e-mail is sent.', 'assetwatch') }}
            </p>
            <label class="form-check">
               <input class="form-check-input" type="checkbox" name="check_probe" value="1" {{ settings.checkProbe ? 'checked' : '' }}>
               <span class="form-check-label">{{ __('Enable the liveness probe (alerts "Not answering" and "Agent not answering")', 'assetwatch') }}</span>
            </label>
            <label class="form-check">
               <input class="form-check-input" type="checkbox" name="probe_devices" value="1" {{ settings.probeDevices ? 'checked' : '' }}>
               <span class="form-check-label">{{ __('Also probe the assets placed in a rack that have no agent (by TCP, on their IP addresses)', 'assetwatch') }}</span>
            </label>
            <div class="row mt-2">
               <div class="col-sm-4">
                  <label class="form-label" for="probe_fail_count">{{ __('Alert after N failed checks in a row', 'assetwatch') }}</label>
                  <input class="form-control" type="number" min="1" max="20" id="probe_fail_count" name="probe_fail_count" value="{{ settings.probeFailCount }}">
               </div>
               <div class="col-sm-4">
                  <label class="form-label" for="probe_timeout">{{ __('Timeout (seconds)', 'assetwatch') }}</label>
                  <input class="form-control" type="number" min="1" max="15" id="probe_timeout" name="probe_timeout" value="{{ settings.probeTimeout }}">
               </div>
               <div class="col-sm-4">
                  <label class="form-label" for="probe_tcp_ports">{{ __('TCP ports tried', 'assetwatch') }}</label>
                  <input class="form-control" type="text" id="probe_tcp_ports" name="probe_tcp_ports" value="{{ settings.probeTcpPorts|join(',') }}" placeholder="22,3389,443,80">
               </div>
            </div>
            <p class="small text-muted mt-2 mb-2">
               {% if probe_last %}
                  {{ __('Last run %1$s: %2$d answer, %3$d agent not answering, %4$d not answering.', 'assetwatch')|format(probe_last, probe_counts.ok, probe_counts.agent_down, probe_counts.unreachable) }}
               {% else %}
                  {{ __('Not run yet.', 'assetwatch') }}
               {% endif %}
               {{ __('If most machines fail in one run, the probe assumes a network problem on the GLPI side and leaves the alerts as they are.', 'assetwatch') }}
            </p>
            <button type="submit" name="probe_test" value="1" class="btn btn-outline-secondary" formnovalidate>
               <i class="ti ti-player-play me-1"></i>{{ __('Probe once now (test, no e-mail)', 'assetwatch') }}
            </button>
            {% if probe_test %}
               <div class="alert {{ probe_test.ok == probe_test.total ? 'alert-success' : 'alert-warning' }} mt-3 mb-0">
                  <div>
                  <b>{{ __('Test result', 'assetwatch') }}</b>:
                  {{ __('%1$d target(s) in %2$s s: %3$d answer, %4$d agent not answering, %5$d not answering.', 'assetwatch')|format(probe_test.total, probe_test.seconds, probe_test.ok, probe_test.agent_down, probe_test.unreachable) }}
                  {% if probe_test.storm %}<br>{{ __('Most targets failed: check that the GLPI host can reach the machines (firewall, routing) before enabling the probe.', 'assetwatch') }}{% endif %}
                  {% if probe_test.failures is not empty %}
                     <ul class="mb-0 mt-2">
                        {% for f in probe_test.failures|slice(0, 30) %}
                           <li><a href="{{ f.url }}">{{ f.name }}</a> <small class="text-muted">{{ f.type }}</small> —
                              {{ f.result == 'agent_down' ? __('Agent not answering', 'assetwatch') : __('Not answering', 'assetwatch') }}
                              <small class="text-muted">({{ f.checked }})</small></li>
                        {% endfor %}
                     </ul>
                  {% endif %}
                  </div>
               </div>
            {% endif %}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Checks on inventory data', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <label class="form-check">
               <input class="form-check-input" type="checkbox" name="check_reboot" value="1" {{ settings.checkReboot ? 'checked' : '' }}>
               <span class="form-check-label">{{ __('Unexpected reboot (boot time reported by the agent changed)', 'assetwatch') }}</span>
            </label>
            <div class="ms-4 mb-3">
               <label class="form-label small" for="reboot_quiet_hours">{{ __('Not reported when the boot time is in these daily windows (e.g. 02:00-06:00, comma separated)', 'assetwatch') }}</label>
               <input class="form-control form-control-sm" style="max-width: 20rem" type="text" id="reboot_quiet_hours" name="reboot_quiet_hours" value="{{ settings.rebootQuietHours }}" placeholder="02:00-06:00">
            </div>
            <label class="form-check">
               <input class="form-check-input" type="checkbox" name="check_antivirus" value="1" {{ settings.checkAntivirus ? 'checked' : '' }}>
               <span class="form-check-label">{{ __('Antivirus disabled, not up to date or license expired (as reported by the agent)', 'assetwatch') }}</span>
            </label>
            <label class="form-check">
               <input class="form-check-input" type="checkbox" name="check_disk_forecast" value="1" {{ settings.checkDiskForecast ? 'checked' : '' }}>
               <span class="form-check-label">{{ __('Disk filling up: free space trend of the last 30 days reaches the low-space threshold within', 'assetwatch') }}</span>
            </label>
            <div class="ms-4 mb-3 d-flex align-items-center gap-2">
               <input class="form-control form-control-sm" style="max-width: 6rem" type="number" min="1" max="365" name="disk_forecast_days" value="{{ settings.diskForecastDays }}" aria-label="{{ __('days', 'assetwatch') }}">
               <span class="small">{{ __('days', 'assetwatch') }}</span>
            </div>
            <label class="form-label" for="agent_min_version">{{ __('Minimum GLPI Agent version (empty = not checked)', 'assetwatch') }}</label>
            <input class="form-control" style="max-width: 10rem" type="text" id="agent_min_version" name="agent_min_version" value="{{ settings.agentMinVersion }}" placeholder="1.11">
            {% if agent_versions is not empty %}
               <p class="small text-muted mt-1 mb-0">{{ __('In use:', 'assetwatch') }}
                  {% for v, n in agent_versions %}<span class="badge bg-secondary-lt me-1">{{ v }} × {{ n }}</span>{% endfor %}
               </p>
            {% endif %}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Network identity', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <label class="form-label" for="port_excluded_patterns">{{ __('Ignored network interfaces (virtual / container), * wildcard', 'assetwatch') }}</label>
            <textarea class="form-control" rows="3" id="port_excluded_patterns" name="port_excluded_patterns">{{ settings.portExcludedPatterns|join(',') }}</textarea>
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Datacenter inventory', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <p class="text-muted">{{ __('Used by the inventory page (Tools > Datacenter inventory) and its dashboard card; no e-mail is sent.', 'assetwatch') }} <a href="{{ audit_url }}">{{ __('Open the inventory page', 'assetwatch') }}</a></p>
            <div class="mb-3">
               <label class="form-label" for="retire_days">{{ __('"Probably removed" after (days without inventory)', 'assetwatch') }}</label>
               <input class="form-control" style="max-width: 10rem" type="number" min="1" id="retire_days" name="retire_days" value="{{ settings.retireDays }}">
            </div>
            <label class="form-label">{{ __('Networks of each server room (one per line, e.g. 10.1.0.0/16; empty = not checked)', 'assetwatch') }}</label>
            {% if rooms is empty %}
               <p class="text-muted mb-0">{{ __('No server room yet (Assets > Datacenters).', 'assetwatch') }}</p>
            {% else %}
               <table class="table table-sm">
                  {% for room in rooms %}
                     <tr>
                        <td style="width: 40%">{{ room.datacenter }} / {{ room.name }}</td>
                        <td>
                           <textarea class="form-control form-control-sm" rows="2" name="room_subnets[{{ room.id }}]" placeholder="10.1.0.0/16">{{ room.subnets }}</textarea>
                           {% if room.invalid is not empty %}
                              <div class="text-danger small">{{ __('Ignored (not a network): %s', 'assetwatch')|format(room.invalid|join(', ')) }}</div>
                           {% endif %}
                        </td>
                     </tr>
                  {% endfor %}
               </table>
            {% endif %}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h3 class="card-title">{{ __('Notifications and history', 'assetwatch') }}</h3></div>
         <div class="card-body">
            <div class="row mb-3">
               <div class="col-sm-6">
                  <label class="form-label" for="reminder_days">{{ __('Reminder every (days, 0 = never)', 'assetwatch') }}</label>
                  <input class="form-control" type="number" min="0" id="reminder_days" name="reminder_days" value="{{ settings.reminderDays }}">
               </div>
               <div class="col-sm-6">
                  <label class="form-label" for="retention_days">{{ __('Keep history (days)', 'assetwatch') }}</label>
                  <input class="form-control" type="number" min="1" id="retention_days" name="retention_days" value="{{ settings.retentionDays }}">
               </div>
            </div>
            <p class="text-muted mb-0">
               {{ __('Recipients and e-mail contents are managed in Setup > Notifications (notifications named "Asset Watch - ...").', 'assetwatch') }}
            </p>
         </div>
      </div>

      <button type="submit" name="update" value="1" class="btn btn-primary mb-4">
         <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
      </button>
   </form>
</div>
